{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "small" },
  "display": {
    "separator": "  ",
    "key": { "width": 8 }
  },
  "modules": [
    "title",
    "os",
    "kernel",
    { "type": "wm", "key": "WM" },
    "terminal",
    "shell",
    "cpu",
    "gpu",
    "memory",
    { "type": "disk", "folders": "/" }
  ]
}
