{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 6,
    "modules-left": [
        "sway/workspaces",
        "sway/mode"
    ],
    "modules-center": [
        "custom/weather",
        "clock"
    ],
    "modules-right": [
        "custom/keybinds",
        "custom/gamma",
        "backlight",
        "pulseaudio#microphone",
        "pulseaudio",
        "network",
        "battery",
        "tray"
    ],
    "clock": {
        "format": "{:%a %d %b  󰥔 %H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "on-scroll": 1
        }
    },
    "custom/weather": {
        "exec": "~/.config/waybar/scripts/weather.sh",
        "exec-if": "ping -c1 -W2 wttr.in",
        "interval": 1800,
        "format": "{}",
        "tooltip": false
    },
    "battery": {
        "format": "{capacity}%  {icon}",
        "format-icons": [
            "󰂎",
            "󰁺",
            "󰁼",
            "󰁾",
            "󰂀",
            "󰁹"
        ]
    },
    "pulseaudio": {
        "format": "󰕾 {volume}%",
        "format-muted": "󰖁 muted",
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +2%",
        "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -2%",
        "tooltip-format": "{desc} | {volume}%"
    },
    "pulseaudio#microphone": {
        "format": "{format_source}",
        "format-source": "󰍬 {volume}%",
        "format-source-muted": "󰍭 muted",
        "on-click": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
        "on-scroll-up": "pactl set-source-volume @DEFAULT_SOURCE@ +2%",
        "on-scroll-down": "pactl set-source-volume @DEFAULT_SOURCE@ -2%",
        "tooltip-format-source": "Mic: {volume}%"
    },
    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["󰋙", "󰃝", "󰃟", "󰃠"],
        "on-scroll-up": "brightnessctl set +5%",
        "on-scroll-down": "brightnessctl set 5%-",
        "tooltip": false
    },
    "network": {
        "format-wifi": "󰤨 {essid}",
        "format-ethernet": "󰈀 wired",
        "format-disconnected": "󰤭 offline",
        "tooltip-format-wifi": "{ipaddr} | {signalStrength}% | {frequency} GHz",
        "tooltip-format-ethernet": "{ipaddr}",
        "tooltip-format-disconnected": "disconnected",
        "on-click": "nm-connection-editor"
    },
    "custom/keybinds": {
        "format": "󰌌",
        "on-click": "~/.config/waybar/scripts/keybinds-help.sh",
        "tooltip": false
    },
    "custom/gamma": {
        "exec": "pgrep wlsunset > /dev/null && echo '󱩌 warm' || echo '󰌵 cool'",
        "on-click": "pgrep wlsunset > /dev/null && pkill wlsunset || wlsunset -t 3500 -T 6500",
        "interval": 5,
        "tooltip": false
    }
}
