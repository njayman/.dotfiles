exec_always dbus-update-activation-environment --systemd \
  WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP \
  QT_QPA_PLATFORMTHEME XCURSOR_THEME XCURSOR_SIZE
exec_always gsettings set org.gnome.desktop.interface gtk-theme 'Colloid-Dark'
exec_always gsettings set org.gnome.desktop.interface icon-theme 'Colloid-Dark'
exec_always gsettings set org.gnome.desktop.interface font-name 'Fira Sans 10'
exec_always gsettings set org.gnome.desktop.interface cursor-theme 'oreo_black_cursors'
exec_always gsettings set org.gnome.desktop.interface cursor-size 24
exec_always gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
exec_always /usr/bin/gnome-keyring-daemon --start --components=secrets,ssh
exec /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1
exec --no-startup-id blueman-applet
exec --no-startup-id bluetoothctl power off
exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ 1
exec clipse -listen
exec --no-startup-id pasystray
seat * xcursor_theme oreo_black_cursors 24

### Window rules
for_window [window_role="pop-up"] floating enable
for_window [window_role="bubble"] floating enable
for_window [window_role="dialog"] floating enable
for_window [window_type="dialog"] floating enable
for_window [class="(?i)pinentry"] floating enable
for_window [app_id="brave-browser" window_role="pop-up"] floating enable
for_window [app_id="brave-browser" window_role="task_dialog"] floating enable
for_window [app_id="brave-browser" window_type="menu"] floating enable



### Variables
set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term ghostty
set $menu XDG_DATA_DIRS=$HOME/.local/share/flatpak/exports/share:/var/lib/flatpak/exports/share:/usr/local/share:/usr/share wofi --show drun --allow-images

### Keybindings (generated from keybinds.json)
include ~/.config/sway/keybinds.conf

### Input
input "13357:58375:Lucky65V2_Lucky65V2_Keyboard" {
    repeat_delay 600
    repeat_rate 25
}

### Output configuration
exec_always swaybg -i "$(find ~/Pictures/Wallpapers -type f | shuf -n 1)" -m fill

output "Microstep MSI MP273Q E2 PB6H465800505" {
    mode 2560x1440@100.00hz
}

### Misc
floating_modifier $mod normal

### Resize mode
mode "resize" {
    bindsym $left  resize shrink width 10px
    bindsym $down  resize grow height 10px
    bindsym $up    resize shrink height 10px
    bindsym $right resize grow width 10px

    bindsym Left  resize shrink width 10px
    bindsym Down  resize grow height 10px
    bindsym Up    resize shrink height 10px
    bindsym Right resize grow width 10px

    bindsym Return mode "default"
    bindsym Escape mode "default"
}

### Status Bar
exec_always ~/.config/eww/scripts/launch.sh

### Window decoration
default_border pixel 2
default_floating_border pixel 2

smart_gaps on
smart_borders on
hide_edge_borders smart

gaps inner 6
gaps outer 2

client.focused          #974b46 #974b46 #d6d0d6 #bb8a87
client.unfocused        #0a0a0a #0a0a0a #6f6a78 #0a0a0a
client.focused_inactive #79241f #79241f #d6d0d6 #79241f
client.urgent           #bb8a87 #bb8a87 #000000 #bb8a87
client.placeholder      #0a0a0a #0a0a0a #6f6a78 #0a0a0a

for_window [app_id="com.dotfiles.clipse"] floating enable, resize set 622 652
for_window [floating] border pixel 2, move position center
