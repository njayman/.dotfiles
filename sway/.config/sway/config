exec_always dbus-update-activation-environment --systemd \
  WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP
exec /usr/bin/gnome-keyring-daemon --start --components=secrets,ssh
exec /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1
exec --no-startup-id blueman-applet
exec --no-startup-id bluetoothctl power off
exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ 1
exec flatpak run com.github.hluk.copyq
exec --no-startup-id pasystray
exec gammastep -O 3500
set $SSH_AUTH_SOCK $XDG_RUNTIME_DIR/keyring/ssh
seat * xcursor_theme oreo_black_cursors 24

### Window rules
for_window [window_role="pop-up"] floating enable
for_window [window_role="bubble"] floating enable
for_window [window_role="dialog"] floating enable
for_window [window_type="dialog"] floating enable
for_window [class="(?i)pinentry"] floating enable
for_window [app_id="brave-browser" window_role="pop-up"] floating enable
for_window [app_id="brave-browser" window_role="task_dialog"] floating enable
for_window [app_id="brave-browser" window_type="menu"] floating enable



### Variables
set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term ghostty
set $menu wofi --show drun --allow-images

### Keybindings (generated from keybinds.json)
include ~/.config/sway/keybinds.conf

### Output configuration
exec_always swaybg -i "$(find ~/Pictures/Wallpapers -type f | shuf -n 1)" -m fill

output HDMI-A-2 {
    mode 2560x1440@100.00hz
}

### Misc
floating_modifier $mod normal

### Resize mode
mode "resize" {
    bindsym $left  resize shrink width 10px
    bindsym $down  resize grow height 10px
    bindsym $up    resize shrink height 10px
    bindsym $right resize grow width 10px

    bindsym Left  resize shrink width 10px
    bindsym Down  resize grow height 10px
    bindsym Up    resize shrink height 10px
    bindsym Right resize grow width 10px

    bindsym Return mode "default"
    bindsym Escape mode "default"
}

### Status Bar
bar {
    swaybar_command waybar
}

### Window decoration
default_border pixel 2
default_floating_border pixel 2

smart_gaps on
smart_borders on
hide_edge_borders smart

gaps inner 6
gaps outer 2

client.focused          #5b9bf8 #5b9bf8 #ffffff #5b9bf8
client.unfocused        #2C2C2C #2C2C2C #bfbfbf #2C2C2C
client.focused_inactive #242424 #242424 #9e9e9e #242424
client.urgent           #fd5f51 #fd5f51 #ffffff #fd5f51
client.placeholder      #212121 #212121 #727272 #212121

for_window [floating] border pixel 2, move position center
